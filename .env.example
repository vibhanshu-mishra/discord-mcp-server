DISCORD_TOKEN=your_bot_token_here

# Read-only mode is enabled by default.
# Set to false only when you intentionally want to enable Discord write tools.
DISCORD_READ_ONLY=true

# Privileged gateway intents requested at connect time (default: true).
# Set to false if the matching toggle is off in the Developer Portal (avoids 4014).
# DISCORD_MESSAGE_CONTENT=true
# DISCORD_GUILD_MEMBERS=true

# Expose only selected toolsets (comma-separated; `all` or unset = everything).
# Unknown names abort startup. See README for the toolset list.
# DISCORD_MCP_TOOLSETS=discovery,messages,members

# Restrict the server to specific guild IDs (comma-separated). When set, calls
# addressed by guild, channel, thread, webhook or invite outside the list fail.
# DISCORD_ALLOWED_GUILDS=123456789012345678,234567890123456789

# ─── Local Discord Analytics (Phase 2) ──────────────────────────────────────
# Analytics stores server activity in a PRIVATE local SQLite database for later
# reporting. It reads Discord only — it never sends, edits, deletes, reacts, or
# acknowledges anything, and it works while DISCORD_READ_ONLY=true. See the
# "Local Discord Analytics" section of the README before enabling it.

# Master switch. Analytics is DISABLED by default. Set to true to turn it on.
DISCORD_ANALYTICS_ENABLED=false

# Where the local SQLite database lives (git-ignored via the data/ rule).
DISCORD_ANALYTICS_DB_PATH=data/discord-analytics.sqlite

# Comma-separated guild IDs analytics may collect from. A guild must ALSO be
# permitted by DISCORD_ALLOWED_GUILDS above — both are required.
DISCORD_ANALYTICS_GUILD_IDS=

# Optional default start date for historical imports (YYYY-MM-DD). Leave blank
# to import as far back as Discord allows.
DISCORD_ANALYTICS_HISTORY_START_DATE=

# Messages fetched per Discord API page during history sync (1–100).
DISCORD_ANALYTICS_SYNC_PAGE_LIMIT=100

# Record voice-channel joins/leaves while the bot is online (for office hours).
DISCORD_ANALYTICS_COLLECT_VOICE=true

# Store DMs sent directly to the bot. These are never guild messages. Default off.
DISCORD_ANALYTICS_COLLECT_BOT_DMS=false

# Store readable message text locally. Default true, because later topic and
# unanswered-question analysis needs the text. When false, only metadata and a
# one-way hash are kept. WARNING: with this on, private community messages are
# stored on your machine — never commit the database.
DISCORD_ANALYTICS_STORE_MESSAGE_CONTENT=true

# ─── Community Metrics & Reporting (Phase 3) ────────────────────────────────
# These configure the read-only reporting tools (member engagement, user
# activity, staff responses, unanswered questions, unacknowledged messages,
# training cadence, office hours, weekly metrics). All read ONLY the local
# database; none of them ever contact or modify Discord.

# OPTIONAL primary user's Discord ID — e.g. the community owner or lead admin
# whose activity should appear in the weekly report. Not required by the
# discord_get_user_activity tool, which takes a user_id directly. When set, this
# ID is validated and added to the effective staff set. Do not commit a real ID.
DISCORD_ANALYTICS_PRIMARY_USER_ID=

# Comma-separated Discord user IDs treated as staff. The primary user's ID (above)
# is automatically added to the effective staff set when configured.
DISCORD_ANALYTICS_STAFF_USER_IDS=

# Channels where weekly trainings/resources should be posted (for cadence checks).
DISCORD_ANALYTICS_RESOURCE_CHANNEL_IDS=

# Voice channels used for office hours (for attendance metrics).
DISCORD_ANALYTICS_OFFICE_HOUR_CHANNEL_IDS=

# Hours a staff response may take before a question is considered open (1..8760).
DISCORD_ANALYTICS_RESPONSE_WINDOW_HOURS=24

# Hours a reply/reaction may take before a message is considered unacknowledged.
DISCORD_ANALYTICS_ACKNOWLEDGEMENT_WINDOW_HOURS=24

# IANA time zone used for daily and weekly grouping (e.g. America/New_York).
DISCORD_ANALYTICS_TIMEZONE=UTC

# First day used for weekly grouping. Supported values: MONDAY or SUNDAY.
DISCORD_ANALYTICS_WEEK_START=MONDAY

# Optional comma-separated words that help identify training/resource posts.
DISCORD_ANALYTICS_TRAINING_KEYWORDS=training,workshop,resource,guide,replay,office hours

# ─── Qualitative Analysis & Content Privacy (Phase 4) ───────────────────────
# The qualitative tools do deterministic, lexical analysis of stored messages and
# return structured EVIDENCE for your MCP client to interpret. This server never
# calls Claude, OpenAI, Gemini, or any other AI provider. All qualitative tools
# are read-only toward both Discord and the local database.

# PRIVACY GATE: allow readable message excerpts to be returned through MCP tools.
# Disabled by default because community messages may be sensitive. Returning
# content sends it to your connected MCP client. This is SEPARATE from
# DISCORD_ANALYTICS_STORE_MESSAGE_CONTENT — BOTH must be true before any excerpt
# can leave the local database.
DISCORD_ANALYTICS_ALLOW_CONTENT_OUTPUT=false

# Maximum characters returned for one message excerpt (1..1000).
DISCORD_ANALYTICS_MAX_EXCERPT_CHARACTERS=240

# Maximum message evidence items returned by one tool call (1..500).
DISCORD_ANALYTICS_MAX_EVIDENCE_MESSAGES=100

# Replace Discord mentions (@user/@role/#channel/@everyone/@here) with placeholders.
DISCORD_ANALYTICS_REDACT_MENTIONS=true

# Replace user IDs and display names in qualitative outputs with generic labels
# (Member 1, Staff 1, Primary User). Recommended on for privacy.
DISCORD_ANALYTICS_PSEUDONYMIZE_USERS=true

# Comma-separated channels excluded from qualitative content analysis (filtered
# before any content leaves SQLite).
DISCORD_ANALYTICS_QUALITATIVE_EXCLUDED_CHANNEL_IDS=

# Include messages written by configured staff in topic/feedback analysis.
DISCORD_ANALYTICS_QUALITATIVE_INCLUDE_STAFF=false

# Minimum distinct messages before a lexical topic candidate is reported.
DISCORD_ANALYTICS_TOPIC_MIN_MESSAGES=3

# Maximum number of topic candidates returned (1..100).
DISCORD_ANALYTICS_TOPIC_LIMIT=15

# Similarity threshold for recurring-question grouping (0.0..1.0).
DISCORD_ANALYTICS_QUESTION_SIMILARITY_THRESHOLD=0.65

# ─── Operations, Backups & Deployment (Phase 5) ─────────────────────────────
# Used by the operations CLI (doctor, db-check, sync, backup, export, prune).
# None of these settings affect Discord; they configure local operation only.

# Log verbosity for the server and CLI: error, warning, info, or debug.
DISCORD_MCP_LOG_LEVEL=info

# Default retention cutoff in days for `prune`. 0 (default) disables the default
# cutoff — nothing is ever pruned automatically; `prune` is always manual and
# requires --confirm.
DISCORD_ANALYTICS_RETENTION_DAYS=0

# Process/database lock file location (prevents two writers on one database).
DISCORD_ANALYTICS_LOCK_PATH=data/discord-analytics.lock

# Default directories for `backup` and `export` output (both git-ignored).
DISCORD_ANALYTICS_BACKUP_DIR=backups
DISCORD_ANALYTICS_EXPORT_DIR=exports
